#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# postCreateCommand, as the remote user: clone the course, and the starter the
# factory lives in, if either is missing. A failed clone is reported but never
# fails the hook: Tutor still starts and shows the student why the course is
# missing.
set -euo pipefail
# shellcheck source=tutor-feature-common.sh
. /usr/local/share/tutor/bin/tutor-feature-common.sh

# clone_missing <label> <option name> <dir> <repo>: <dir> empty skips it.
clone_missing() {
    local label="$1" option="$2" dir="$3" repo="$4" parent
    [ -n "$dir" ] || return 0
    if [ -e "$dir" ] || [ -L "$dir" ]; then
        tutor_log "$label found at $dir"
        return 0
    fi
    if [ -z "$repo" ]; then
        tutor_log "no $label at $dir and $option is empty; not cloning"
        return 0
    fi
    parent="$(dirname -- "$dir")"
    if [ ! -d "$parent" ] || [ ! -w "$parent" ]; then
        tutor_log "WARNING: cannot clone the $label: $parent is not a writable directory"
        return 0
    fi
    tutor_log "cloning $repo into $dir"
    if ! GIT_TERMINAL_PROMPT=0 git clone --quiet -- "$repo" "$dir"; then
        tutor_log "WARNING: cloning the $label failed; clone it yourself with: git clone $repo $dir"
    fi
}

tutor_validate_options
clone_missing course courseRepo "$TUTOR_COURSE" "$TUTOR_COURSE_REPO"
clone_missing starter starterRepo "$TUTOR_STARTER" "$TUTOR_STARTER_REPO"
