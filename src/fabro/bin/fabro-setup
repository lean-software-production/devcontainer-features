#!/usr/bin/env bash
# Interactive Fabro setup wizard.
#
#   fabro-setup           run the wizard, or exit quietly if already configured
#   fabro-setup --force   run it again even when a credential already exists
#
# Designed to be launched from a VS Code folderOpen task, so the common case --
# an already-configured container -- must be silent and instant.
set -uo pipefail

[ -r /usr/local/share/fabro/setup.env ] && . /usr/local/share/fabro/setup.env
DEFAULT_PROVIDER="${FABRO_SETUP_PROVIDER:-openai}"
MARKER="${FABRO_SETUP_MARKER:-${HOME}/.fabro/.setup-complete}"
SETTINGS="${HOME}/.fabro/settings.toml"

FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

bold=$'\033[1m'; dim=$'\033[2m'; cyan=$'\033[1;36m'
green=$'\033[1;32m'; yellow=$'\033[1;33m'; red=$'\033[1;31m'; reset=$'\033[0m'

step() { printf '\n%s==>%s %s%s%s\n' "${cyan}" "${reset}" "${bold}" "$*" "${reset}"; }
ok()   { printf '    %s✓%s %s\n' "${green}" "${reset}" "$*"; }
warn() { printf '    %s!%s %s\n' "${yellow}" "${reset}" "$*"; }
fail() { printf '    %s✗%s %s\n' "${red}" "${reset}" "$*"; }
info() { printf '    %s%s%s\n' "${dim}" "$*" "${reset}"; }

# --- fast path --------------------------------------------------------------
if [ "${FORCE}" -eq 0 ] && fabro-status --quiet; then
    touch "${MARKER}" 2>/dev/null || true
    exit 0
fi

# --- a wizard needs a terminal ---------------------------------------------
if [ ! -t 0 ] || [ ! -t 1 ]; then
    printf '\n  %sFabro needs one interactive step.%s\n' "${bold}" "${reset}"
    printf '  Open a terminal and run: %sfabro-setup%s\n\n' "${bold}" "${reset}"
    exit 0
fi

cat <<BANNER

  ${cyan}Fabro setup${reset}
  ${dim}Connects this dev container to an LLM account. Credentials are stored
  in the local Fabro server vault and never written to the repository.${reset}
BANNER

# --- 1. CLI -----------------------------------------------------------------
step "Checking the Fabro CLI"
if ! command -v fabro >/dev/null 2>&1; then
    fail "fabro is not on PATH. Rebuild the dev container."
    exit 1
fi
ok "$(fabro --version)"

# --- 2. Base configuration --------------------------------------------------
step "Preparing ~/.fabro"
if [ -f "${SETTINGS}" ]; then
    ok "Configuration already present"
else
    # `fabro install --non-interactive` insists on a GitHub strategy, and the
    # token strategy reads from `gh`. Get gh authenticated first if needed.
    if ! gh auth token >/dev/null 2>&1; then
        info "Fabro needs a GitHub token. Signing in with the GitHub CLI first."
        info "This is also a device-code flow, so it works in Codespaces."
        gh auth login || true
    fi

    github_user="${GITHUB_USER:-}"
    [ -z "${github_user}" ] && github_user="$(gh api user -q .login 2>/dev/null || true)"

    if [ -n "${github_user}" ] && gh auth token >/dev/null 2>&1; then
        if fabro install --non-interactive --skip-llm \
            --github-strategy token --github-username "${github_user}"; then
            ok "Configured ~/.fabro/settings.toml for ${github_user}"
        else
            fail "fabro install failed. Run it manually: fabro install"
            exit 1
        fi
    else
        fail "No GitHub credential. Run 'gh auth login', then 'fabro-setup' again."
        exit 1
    fi
fi

# --- 3. Server --------------------------------------------------------------
step "Starting the local Fabro server"
if fabro server status >/dev/null 2>&1; then
    ok "Already running"
elif fabro server start; then
    ok "Started"
else
    fail "The server did not start. Check 'fabro server start' output above."
    exit 1
fi

# --- 4. Provider choice -----------------------------------------------------
step "Choosing an LLM provider"
cat <<MENU
    ${bold}1${reset}  OpenAI  ${dim}- sign in with a ChatGPT or Codex subscription (no API key)${reset}
    ${bold}2${reset}  Anthropic  ${dim}- paste an Anthropic API key${reset}
    ${bold}3${reset}  OpenRouter  ${dim}- paste an OpenRouter API key${reset}
    ${bold}4${reset}  Skip  ${dim}- configure later with 'fabro provider login'${reset}
MENU

case "${DEFAULT_PROVIDER}" in
    openai) default_choice=1 ;;
    anthropic) default_choice=2 ;;
    openrouter) default_choice=3 ;;
    *) default_choice=4 ;;
esac

printf '\n    Provider [%s]: ' "${default_choice}"
read -r choice
[ -z "${choice}" ] && choice="${default_choice}"

case "${choice}" in
    1) provider=openai ;;
    2) provider=anthropic ;;
    3) provider=openrouter ;;
    4) provider="" ;;
    *) fail "Unrecognized choice '${choice}'."; exit 1 ;;
esac

if [ -z "${provider}" ]; then
    warn "Skipped. Run 'fabro-setup --force' when you are ready."
    exit 0
fi

# --- 5. Sign in -------------------------------------------------------------
step "Signing in to ${provider}"
if [ "${provider}" = "openai" ]; then
    info "Fabro will print a URL and a one-time code."
    info "Ctrl+click the URL, sign in, enter the code, then answer 'y' here."
fi

if ! fabro provider login --provider "${provider}"; then
    fail "Login failed. You can retry with: fabro-setup --force"
    exit 1
fi
ok "Signed in to ${provider}"

# --- 6. Make it the default -------------------------------------------------
# Pin only the provider, not a model name, so the provider's own default model
# is used and this does not go stale as catalogs change.
step "Setting ${provider} as the default provider"
tmp="$(mktemp)"
awk -v provider="${provider}" '
    /^\[run\.model\]/ { skip = 1; next }
    /^\[/ && skip && $0 !~ /^\[run\.model\./ { skip = 0 }
    !skip { print }
    END { printf "\n[run.model]\nprovider = \"%s\"\n", provider }
' "${SETTINGS}" > "${tmp}" && mv "${tmp}" "${SETTINGS}"
ok "Wrote [run.model] to ~/.fabro/settings.toml"

# --- 7. Verify --------------------------------------------------------------
step "Verifying"
if fabro-status; then
    touch "${MARKER}" 2>/dev/null || true
else
    warn "Fabro reports no usable credential. Run 'fabro doctor' for detail."
    exit 1
fi

cat <<DONE

  ${green}Setup complete.${reset}

  ${dim}Run a workflow:${reset}   fabro run <workflow>
  ${dim}Check health:${reset}     fabro doctor
  ${dim}Change provider:${reset}  fabro-setup --force

DONE
